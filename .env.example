# Supabase: Project Settings -> Database -> Connection string
# DATABASE_URL = "Transaction" pooler connection (port 6543, pgbouncer=true) — used at runtime
# DIRECT_URL   = "Session"/direct connection (port 5432) — used only for migrations
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-32-byte-base64-secret"
