// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MEMBRO
}

enum PlaylistVisibility {
  DRAFT
  PUBLISHED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(MEMBRO)
  active       Boolean  @default(true)

  accounts  Account[]
  sessions  Session[]
  favorites Favorite[]
  playlists Playlist[] @relation("PlaylistOwner")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

// --- NextAuth/Auth.js required models (Prisma adapter) ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Song {
  id          String  @id @default(cuid())
  titulo      String
  artista     String?
  ministerio  String?
  tomOriginal String
  tomAtual    String
  capo        Int?    @default(0)
  bpm         Int?
  genero      String?
  observacoes String? @db.Text
  linkYoutube String?
  cifra       String  @db.Text

  tags          SongTag[]
  playlistSongs PlaylistSong[]
  favorites     Favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([titulo])
  @@index([artista])
  @@index([genero])
}

model Tag {
  id   String @id @default(cuid())
  nome String @unique

  songs SongTag[]
}

model SongTag {
  songId String
  tagId  String

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([songId, tagId])
  @@index([tagId])
}

model Playlist {
  id         String             @id @default(cuid())
  nome       String
  data       DateTime
  culto      String?
  descricao  String?            @db.Text
  visibility PlaylistVisibility @default(DRAFT)

  responsavelId String
  responsavel   User   @relation("PlaylistOwner", fields: [responsavelId], references: [id], onDelete: Restrict)

  songs PlaylistSong[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([data])
  @@index([responsavelId])
  @@index([visibility])
}

model PlaylistSong {
  id         String  @id @default(cuid())
  playlistId String
  songId     String
  ordem      Int
  notas      String?  @db.Text

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: deleting a Song shouldn't silently vanish from historical setlists.
  song     Song     @relation(fields: [songId], references: [id], onDelete: Restrict)

  @@unique([playlistId, songId])
  @@index([songId])
  @@index([playlistId, ordem])
}

model Favorite {
  id     String @id @default(cuid())
  userId String
  songId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, songId])
  @@index([songId])
}
